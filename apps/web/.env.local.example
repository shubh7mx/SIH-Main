# SIH26162 · Frontend Environment Variables
# Copy this file to .env.local and fill in real values for each environment.

# ── API Base URL ────────────────────────────────────────────────────────────
# The FastAPI backend base URL (no trailing slash).
# In production, point to your deployed API (e.g., https://api.sih26162.ntro.gov.in)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── WebSocket URL ────────────────────────────────────────────────────────────
# Full WebSocket URL for the live alert stream.
# If using the reverse proxy, ensure WS:// is not stripped (nginx config must support it).
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/alerts

# ── Optional: Map tile provider ───────────────────────────────────────────────
# OSM tile server (free, no key required)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Optional: Auth token (reserved for Phase 7) ──────────────────────────────
# NEXT_PUBLIC_AUTH_TOKEN=

# ── Development overrides ─────────────────────────────────────────────────────
# Set to "true" to inject mock data even when the backend is reachable.
# NEXT_PUBLIC_USE_MOCK=false
