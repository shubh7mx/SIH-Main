# ==============================================================================
# SIH26162 — Environment Configuration
# ==============================================================================

# NASA FIRMS API
FIRMS_API_KEY=your_firms_map_key_here
FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_BBOX=6,68,38,98

# PostgreSQL / PostGIS Database
DATABASE_URL=postgresql://sih_user:sih_secret_2026@localhost:5432/sih26162_spatial
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=sih_secret_2026
POSTGRES_DB=sih26162_spatial
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redpanda (Kafka-compatible stream broker)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_RAW=raw-thermal-hotspots
KAFKA_TOPIC_CLASSIFIED=classified-thermal-events
KAFKA_TOPIC_ALERTS=critical-thermal-alerts

# RisingWave (Streaming SQL Engine)
RISINGWAVE_HOST=localhost
RISINGWAVE_PORT=4566
RISINGWAVE_DATABASE=dev

# Qdrant (Vector Database for SDS & Geo-LLM RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis (Deduplication Cache & PubSub)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_TILES=sih26162-satellite-tiles
S3_BUCKET_ARTIFACTS=sih26162-artifacts

# Copernicus Data Space Ecosystem (CDSE / Sentinel-2 STAC)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# OpenStreetMap Overpass API
OVERPASS_URL=https://overpass-api.de/api/interpreter

# AI Intelligence Engine (backend-only — never exposed to frontend)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SITE_URL=https://sih26162.ntro.gov.in
SITE_NAME=NTRO Thermal Intelligence

# FastAPI Application
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=sih26162_production_secret_key_2026
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/alerts
NEXT_PUBLIC_MAPBOX_TOKEN=
