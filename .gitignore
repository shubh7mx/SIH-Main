# ==============================================================================
# SIH26162 — Git Ignore Policy
# AI-Based Detection & Classification of Industrial Fires (NTRO)
# ==============================================================================

# ── Package Managers & Dependencies ───────────────────────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ── Next.js & Frontend Build Outputs ──────────────────────────────────────────
.next/
apps/web/.next/
dist/
out/
build/
.turbo/
*.tsbuildinfo
.eslintcache

# ── Python / Virtual Environments ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# ── Python Testing & Type Checking ────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/
.pytype/
*.egg-info/
.eggs/

# ── Environment Variables & Secrets ───────────────────────────────────────────
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
# Keep example environment template tracked
!.env.example

# ── Databases & Persistent Storage ────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-journal
*.rdb

# Preserve sanitized default event seed cache for immediate repository usage
!apps/api/data/events_store_cache.json

# ── Logs & Temporary Diagnostics ──────────────────────────────────────────────
logs/
*.log
*.log.*
*.err
*.tmp
*.temp
*.swp
*.swo

# ── Temporary Debug / Scratch Scripts ─────────────────────────────────────────
browser_sim.js
browser_sim_v2.js
find_syntax_error.js
landing_3000.html
demo.html
backend.err

# ── OS & Editor Artifacts ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace
*.code-workspace
